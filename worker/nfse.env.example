# Configuração adicional ao worker/.env. Nunca preencher credenciais no Git.
# Primeiro confirmar com GOVBR o ambiente, cadastro, série e algoritmo aceitos.
NFSE_HABILITADO=0
NFSE_AMBIENTE=homologacao
# Produção exige também configuração fiscal e liberação por empresa no banco.
NFSE_PRODUCAO_HABILITADA=0
NFSE_CONFIG_ARQUIVO=
NFSE_CERTIFICADO_SENHA=
