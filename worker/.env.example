# Copie este arquivo pra ".env" (nunca commitado) e preencha os valores reais.

# Mesmo projeto Supabase do app — pegue a service role key em
# Project Settings > API > service_role (NÃO é a anon/publishable key).
SUPABASE_URL=https://fwmzeaztjxrxxzxzxmgc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bot do Discord — usado só pra mandar DM de alerta quando a sessão do
# WhatsApp cair/precisar logar de novo.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# SMTP pra envio do PDF da ata por e-mail (Nodemailer).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Automação de chamados de desenvolvimento (src/chamadosDev.js) — ver
# docs/automacao-chamados.md. Deixe as duas em branco pra desligar a
# automação sem mexer no código.
# UUID do dev em profiles/auth.users (nunca resolver por nome — existem
# contas de teste com nome parecido).
CHAMADOS_DEV_USER_ID=
# Caminho local do repositório onde as worktrees dos chamados são criadas
# (ex: C:\Users\SeuUsuario\Desktop\Projeto_ERP_LOVABLE).
CHAMADOS_DEV_REPO_PATH=

# ── Catálogo de CA do CAEPI/MTE (src/caepi.js) ─────────────────────────
# Em branco = desligado, e é assim que vem de propósito.
#
# NÃO use a cópia hospedada em
# gov.br/.../equipamentos-de-protecao-individual-epi/tgg_export_caepi.zip:
# ela parece a fonte oficial mas está congelada em 19/01/2023. Medido no
# arquivo: diz que 13.088 CAs estão "VÁLIDO", e nenhuma validade passa de
# 2025. Ligar aquilo marcaria como vencido quase todo CA legítimo e travaria
# entrada de EPI no estoque.
#
# A fonte viva é o botão "Base de dados do sistema CAEPI (Download)" em
# https://caepi.trabalho.gov.br/internet/consultaCAInternet.aspx
CAEPI_URL=

# ── NF-e de entrada pela SEFAZ (src/nfe.js) ────────────────────────────
# Em branco = desligado.
#
# O certificado A1 da empresa usa RC2-40-CBC, cifra legada: o worker PRECISA
# rodar com `node --openssl-legacy-provider` (já está no script `start`).
# Sem a flag o erro é ERR_CRYPTO_UNSUPPORTED_OPERATION, que não diz nada
# sobre a causa.
#
# Aponte para uma CÓPIA LOCAL do .pfx, nunca para o arquivo do servidor da
# empresa — aquele é usado por outras demandas e é somente leitura.
NFE_CERT_PATH=
NFE_CERT_PASS=
NFE_CNPJ=
# 43 = RS (UF do autor da consulta, não do emitente da nota).
NFE_CUF=43
# 1 = produção, 2 = homologação. Homologação não devolve documento real.
NFE_AMBIENTE=1
