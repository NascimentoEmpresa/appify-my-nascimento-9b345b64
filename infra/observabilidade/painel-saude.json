{
 "__inputs": [
  {
   "name": "DS_PROM",
   "label": "Prometheus (grafanacloud-…-prom)",
   "type": "datasource",
   "pluginId": "prometheus"
  },
  {
   "name": "DS_LOKI",
   "label": "Loki (grafanacloud-…-logs)",
   "type": "datasource",
   "pluginId": "loki"
  }
 ],
 "title": "ERP — Saúde da produção",
 "uid": "erp-saude-producao",
 "tags": [
  "erp",
  "producao"
 ],
 "timezone": "America/Sao_Paulo",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Agora × ontem (linha tracejada cinza = mesma hora de ontem)",
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Requisições por minuto",
   "description": "Toda requisição à API (sem OPTIONS), log do Kong dos dois nós. 5xx = o usuário viu erro.",
   "id": 2,
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*ontem.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "dash": [
          6,
          6
         ],
         "fill": "dash"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (classe) (count_over_time({servico=\"kong\"}[1m]))",
     "legendFormat": "{{classe}}",
     "datasource": {
      "uid": "${DS_LOKI}"
     }
    },
    {
     "refId": "B",
     "expr": "sum(count_over_time({servico=\"kong\"}[1m] offset 1d))",
     "legendFormat": "total ontem",
     "datasource": {
      "uid": "${DS_LOKI}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "% de respostas 5xx",
   "description": "Acima de 2 % por 2 min = alerta. Em 03/11/2026 chegou a 60 %.",
   "id": 3,
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*ontem.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "dash": [
          6,
          6
         ],
         "fill": "dash"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(count_over_time({servico=\"kong\",classe=\"5xx\"}[1m])) / sum(count_over_time({servico=\"kong\"}[1m]))",
     "legendFormat": "hoje",
     "datasource": {
      "uid": "${DS_LOKI}"
     }
    },
    {
     "refId": "B",
     "expr": "100 * sum(count_over_time({servico=\"kong\",classe=\"5xx\"}[1m] offset 1d)) / sum(count_over_time({servico=\"kong\"}[1m] offset 1d))",
     "legendFormat": "ontem",
     "datasource": {
      "uid": "${DS_LOKI}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Tempo de resposta p95",
   "description": "rt= do log do Kong. O monitor de queda do ERP desiste em 8 s.",
   "id": 4,
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*ontem.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "dash": [
          6,
          6
         ],
         "fill": "dash"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "quantile_over_time(0.95, {servico=\"kong\"} | regexp \"rt=(?P<rt>[0-9.]+)\" | unwrap rt [1m]) by (no)",
     "legendFormat": "{{no}}",
     "datasource": {
      "uid": "${DS_LOKI}"
     }
    },
    {
     "refId": "B",
     "expr": "quantile_over_time(0.95, {servico=\"kong\"} | regexp \"rt=(?P<rt>[0-9.]+)\" | unwrap rt [1m] offset 1d)",
     "legendFormat": "ontem",
     "datasource": {
      "uid": "${DS_LOKI}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "CPU ocupada por nó",
   "description": "O teto do ERP é CPU do banco1 (teste de carga 03/11: ~85 req/s com 2 núcleos cheios).",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*ontem.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "dash": [
          6,
          6
         ],
         "fill": "dash"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - 100 * avg by (no) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))",
     "legendFormat": "{{no}}",
     "datasource": {
      "uid": "${DS_PROM}"
     }
    },
    {
     "refId": "B",
     "expr": "100 - 100 * avg by (no) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m] offset 1d))",
     "legendFormat": "{{no}} ontem",
     "datasource": {
      "uid": "${DS_PROM}"
     }
    }
   ]
  },
  {
   "type": "row",
   "title": "PostgREST — as causas da queda de 03/11, ao vivo",
   "id": 6,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 17
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Pool: livres / esperando / máximo",
   "description": "Esperando > 0 por mais de 1 min = pool cheio (C1 do post-mortem). Livres = 0 é o prenúncio.",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*ontem.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "dash": [
          6,
          6
         ],
         "fill": "dash"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "pgrst_db_pool_available",
     "legendFormat": "livres {{no}}",
     "datasource": {
      "uid": "${DS_PROM}"
     }
    },
    {
     "refId": "B",
     "expr": "pgrst_db_pool_waiting",
     "legendFormat": "esperando {{no}}",
     "datasource": {
      "uid": "${DS_PROM}"
     }
    },
    {
     "refId": "C",
     "expr": "pgrst_db_pool_max",
     "legendFormat": "máximo {{no}}",
     "datasource": {
      "uid": "${DS_PROM}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Pool esgotado (PGRST003) em 5 min",
   "description": "Cada um = um usuário recebeu 504.",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*ontem.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "dash": [
          6,
          6
         ],
         "fill": "dash"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(pgrst_db_pool_timeouts_total[5m])",
     "legendFormat": "{{no}}",
     "datasource": {
      "uid": "${DS_PROM}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Recargas de schema em 5 min",
   "description": "status=FAIL = a recarga estourou e o PostgREST derrubou o pool (C2). Toda migration aplicada gera uma recarga.",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*ontem.*"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "dash": [
          6,
          6
         ],
         "fill": "dash"
        }
       },
       {
        "id": "color",
        "value": {
