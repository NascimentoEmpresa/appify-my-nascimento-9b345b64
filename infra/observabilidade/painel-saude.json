  },
  {
   "type": "timeseries",
   "title": "Statement timeout em 5 min",
   "description": "Consulta cancelada por passar de 8 s (authenticated) ou 3 s (anon).",
   "id": 12,
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 27
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
