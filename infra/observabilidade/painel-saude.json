   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(pgrst_schema_cache_loads_total[5m])",
     "legendFormat": "{{status}} {{no}}",
     "datasource": {
      "uid": "${DS_PROM}"
     }
    }
   ]
  },
  {
